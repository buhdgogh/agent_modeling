# DashScope / Qwen
DASHSCOPE_API_KEY=

# External tracing is disabled by default; local monitoring does not depend on it.
APP_ENABLE_LANGSMITH=false
# Set true above and provide a key only when cloud tracing is needed.
LANGSMITH_API_KEY=

# MySQL chat history
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_chat_db

# Optional Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
