# DashScope / Qwen
DASHSCOPE_API_KEY=

# Optional UTF-8 JSON stratigraphic dictionary used by the text agent.
TEXT_AGENT_DICTIONARY_PATH=

# Word/PDF document parsing. Remote service URL is optional; empty uses local SDK.
DOCUMENT_MINERU_TIER=standard
DOCUMENT_MINERU_API_URL=
MINERU_API_KEY=
DOCUMENT_PARSER_CACHE_REVISION=1

# External tracing is disabled by default; local monitoring does not depend on it.
APP_ENABLE_LANGSMITH=false
# Set true above and provide a key only when cloud tracing is needed.
LANGSMITH_API_KEY=

# Process-wide task/model concurrency; restart the app after changing these.
APP_MAX_MODEL_CONCURRENCY=4
APP_MAX_WORKERS=4
APP_MAX_NODE_CONCURRENCY=2
# Hard constraints always run. Semantic review runs afterwards by default.
APP_SEMANTIC_REVIEW=true
# Empty uses the selected main model; may select a separate reviewer model.
APP_SEMANTIC_REVIEW_MODEL=
# Optional model tariffs per million tokens; no tariff means unknown cost.
# Map each model name to input_per_million, output_per_million and currency.
APP_MODEL_PRICES_JSON={}

# MySQL chat history
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agent_chat_db

# Optional Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
